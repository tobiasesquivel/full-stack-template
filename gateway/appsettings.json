{
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "api": {
        "ClusterId": "monolith",
        "Match": {
          "Path": "/api/{**rest}"
        }
      },
      "tasks": {
        "ClusterId": "tasks",
        "Match": {
          "Path": "/api/v1/tasks/{**rest}"
        }
      }
    },
    "Clusters": {
      "monolith": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:15"
        },
        "HealthCheck": {
          "AvailableDestinationsPolicy": "HealthyAndUnknown",
          "Active": {
            "Enabled": true,
            "Interval": "00:00:05",
            "Timeout": "00:00:02",
            "Policy": "ConsecutiveFailures",
            "Path": "/api/v1/health/live"
          }
        },
        "Metadata": {
          "ConsecutiveFailuresHealthPolicy.Threshold": "2"
        },
        "Destinations": {
          "api": {
            "Address": "http://localhost:8080/"
          }
        }
      },
      "tasks": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:15"
        },
        "HealthCheck": {
          "AvailableDestinationsPolicy": "HealthyAndUnknown",
          "Active": {
            "Enabled": true,
            "Interval": "00:00:05",
            "Timeout": "00:00:02",
            "Policy": "ConsecutiveFailures",
            "Path": "/api/v1/health/live"
          }
        },
        "Metadata": {
          "ConsecutiveFailuresHealthPolicy.Threshold": "2"
        },
        "Destinations": {
          "tasks": {
            "Address": "http://localhost:8082/"
          }
        }
      }
    }
  }
}
