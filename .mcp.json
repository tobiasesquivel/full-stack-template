{
  "mcpServers": {
    "angular-cli": {
      "command": "node",
      "args": [
        "frontend/node_modules/@angular/cli/bin/ng.js",
        "mcp",
        "--read-only",
        "--root",
        "frontend"
      ]
    },
    "excalidraw": {
      "type": "http",
      "url": "https://api.excalidraw.com/api/v1/mcp?toolsets=drawing"
    }
  }
}
