{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=FullStackTemplate;Username=postgres;Password=123456;"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "Session": {
    "AbsoluteExpirationDays": 7,
    "IdleTimeoutMinutes": 30
  },
  "AllowedHosts": "*"
}
