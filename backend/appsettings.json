{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=FullStackTemplate;Username=postgres;Password=123456;"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "Jwt": {
    "Issuer": "https://api.templateapp.com",
    "Audience": "api://default",
    "Key": "your-super-secret-key-at-least-32-characters-long",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "AllowedHosts": "*"
}
