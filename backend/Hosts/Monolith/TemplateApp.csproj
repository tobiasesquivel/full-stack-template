<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TemplateApp</RootNamespace>
    <UserSecretsId>templateapp-backend-dev</UserSecretsId>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BackendRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../..'))</BackendRoot>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="Internal/Generated/**/*.cs" />
    <Compile Include="$(BackendRoot)/Features/**/*.cs" />
    <Compile Remove="$(BackendRoot)/Features/Tasks/**" />
    <Compile Remove="$(BackendRoot)/Features/**/*Tests.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Platform/TemplateApp.Platform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TemplateApp.Tests" />
  </ItemGroup>

</Project>
