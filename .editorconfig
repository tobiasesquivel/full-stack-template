root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{cs,csproj,props,targets,slnx}]
indent_size = 4

[*.{js,mjs,cjs,ts,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

