# Copia a .env y completa los secretos. Los placeholders de este archivo NO son utilizables.
POSTGRES_DB=templateapp
POSTGRES_USER=postgres
POSTGRES_PORT=5432
POSTGRES_PASSWORD=change_me_in_dotenv
RABBITMQ_USER=templateapp
RABBITMQ_PASSWORD=change_me_in_dotenv
API_PORT=8080
WEB_PORT=8081
PROMETHEUS_PORT=9090
OTEL_EXPORT_DIR=./otel-export
ACCOUNT_CLOSURE_GRACE_SECONDS=1209600
ACCOUNT_CLOSURE_FIRST_REMINDER_SECONDS=604800
ACCOUNT_CLOSURE_SECOND_REMINDER_SECONDS=1123200
